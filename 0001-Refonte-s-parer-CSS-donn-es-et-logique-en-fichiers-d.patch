-/* ================== RENDU GLOBAL ================== */
-const app=document.getElementById('app'),hdr=document.getElementById('hdr');
-function render(keepScroll){
- const y=window.scrollY;const c=C();
- if(S.view==='list'||!c){
-  hdr.innerHTML=`<div class="top-row"><div class="who"><b>Configurateur D&amp;D 2024</b><span>Barde et ensorceleur</span></div></div><div style="height:10px"></div>`;
-  app.innerHTML=viewList();bind();window.scrollTo(0,keepScroll?y:0);return;
